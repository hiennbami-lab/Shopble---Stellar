# Backend API base. Leave EMPTY for a deployment: nginx serves the app and proxies
# /api on the same origin, so relative URLs are correct and CORS never applies.
# Only set a host for a dev server pointing at a separately-run API.
VITE_API_BASE=http://localhost:8080

# Horizon endpoint used when submitting a signed payment. Testnet only.
VITE_HORIZON=https://horizon-testnet.stellar.org
