# Copy to .env and fill in. Never commit .env — it holds the operator secret.

# Image tag. Local compose builds and tags this; a swarm stack pulls it, so on swarm
# this must be a registry path (e.g. 127.0.0.1:5000/shopble:latest).
SHOPBLE_IMAGE=shopble:local

# Absolute path on the node for a swarm stack; a relative path is fine for local compose.
SHOPBLE_CONFIG=./config.yml

# Overrides the top-level DB_CONNECTION in config.yml. Use the postgres service name and
# its internal port 5432, not a published host port.
DB_CONNECTION=postgres://admin:password@postgres:5432/shopble?sslmode=disable

# stellar keys secret shopble-operator
SHOPBLE_OPERATOR_SECRET=

# Host port the API is published on.
API_PORT=8081

# --- frontend ---
# Web image tag. On swarm this must be a registry path, same as SHOPBLE_IMAGE.
SHOPBLE_WEB_IMAGE=shopble-web:local

# Host port the frontend is published on. Put TLS in front of this — Freighter only
# injects on https or localhost.
WEB_PORT=8080

# Baked into the bundle at BUILD time. Leave EMPTY so the app calls /api on its own
# origin through the nginx proxy. Setting it to an absolute URL brings CORS back.
VITE_API_BASE=

VITE_HORIZON=https://horizon-testnet.stellar.org
